          <mxGeometry x="72" y="400" width="334" height="24" as="geometry" />
        </mxCell>

        <mxCell id="indicator_inputs" value="&lt;b&gt;当前 Population&lt;/b&gt;&lt;br&gt;objs + decs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="76" y="520" width="132" height="74" as="geometry" />
        </mxCell>
        <mxCell id="sde_block" value="&lt;b&gt;Shape_Estimate → Lp&lt;/b&gt;&lt;br&gt;calFitness_SDE&lt;br&gt;极小 SDE → Minkowski(Lp)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="226" y="506" width="176" height="106" as="geometry" />
        </mxCell>
        <mxCell id="svr_model" value="&lt;b&gt;RBF-SVR 指标代理&lt;/b&gt;&lt;br&gt;&lt;b&gt;IndicatorModel&lt;/b&gt;&lt;br&gt;fitrsvm(decs,Fitness,'rbf')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="102" y="650" width="274" height="74" as="geometry" />
        </mxCell>
        <mxCell id="sde_boundary" value="边界：当前版本是 SDE-only + 局部 Minkowski 回退，不是三指标轮盘" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#B65C1F;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="68" y="738" width="342" height="34" as="geometry" />
        </mxCell>

        <mxCell id="ga_seed" value="&lt;b&gt;初始候选&lt;/b&gt;&lt;br&gt;OperatorGA([Population.decs; Ref.decs])" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="482" y="190" width="296" height="76" as="geometry" />
        </mxCell>
        <mxCell id="ga_relation_select" value="&lt;b&gt;关系代理排序 model_select&lt;/b&gt;&lt;br&gt;保留 |Ref| 个候选&lt;br&gt;关系网络贯穿候选池生成" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="482" y="304" width="296" height="94" as="geometry" />
        </mxCell>
        <mxCell id="ga_operator" value="&lt;b&gt;OperatorGA&lt;/b&gt;&lt;br&gt;由保留集生成新候选" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="482" y="438" width="296" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ga_accumulate" value="&lt;b&gt;累计候选并稳定去重&lt;/b&gt;&lt;br&gt;循环至 gmax（默认 3000）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="482" y="552" width="296" height="78" as="geometry" />
        </mxCell>
        <mxCell id="candidate_pool" value="&lt;b&gt;共享候选池 all_candidates&lt;/b&gt;&lt;br&gt;两种模式从同一候选集合选择" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2.5;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="482" y="688" width="296" height="72" as="geometry" />
        </mxCell>

        <mxCell id="mode_stream" value="&lt;b&gt;独立 RandStream&lt;/b&gt;&lt;br&gt;每代预先抽取 u∈[0,1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EAFE;strokeColor=#7756C5;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#4C2F91;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="842" y="190" width="176" height="82" as="geometry" />
        </mxCell>
        <mxCell id="mode_gate" value="&lt;b&gt;IndicatorModel 有效&lt;/b&gt;&lt;br&gt;且&lt;br&gt;&lt;b&gt;u &amp;lt; pMix (=0.50) ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;perimeter=rhombusPerimeter;fillColor=#F0EAFE;strokeColor=#7756C5;strokeWidth=2.5;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#4C2F91;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="838" y="352" width="184" height="144" as="geometry" />
        </mxCell>
        <mxCell id="mode_result_note" value="&lt;b&gt;条件满足：Indicator&lt;/b&gt;&lt;br&gt;否则：Explore" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#5B3FA3;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="570" width="180" height="56" as="geometry" />
        </mxCell>

        <mxCell id="explore_compare" value="&lt;b&gt;四类关系比较&lt;/b&gt;&lt;br&gt;[C1,Xi] / [Xi,C1] / [C2,Xi] / [Xi,C2]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E7F6F2;strokeColor=#2A8F7A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#155E52;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="182" width="274" height="56" as="geometry" />
        </mxCell>
        <mxCell id="explore_evidence" value="&lt;b&gt;关系净证据 score_rel&lt;/b&gt;&lt;br&gt;max softmax 类概率作组内权重&lt;br&gt;uncertainty = 1−mean(max softmax)&lt;br&gt;（预测模糊度，非认知不确定性）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E7F6F2;strokeColor=#2A8F7A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#155E52;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1076" y="256" width="274" height="80" as="geometry" />
        </mxCell>
        <mxCell id="explore_lambda" value="&lt;b&gt;score_aug = norm(score_rel) + λ_t·norm(uncertainty)&lt;/b&gt;&lt;br&gt;λ_t = λ0(1−ratio)·max(0,1−p_err/0.45)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E7F6F2;strokeColor=#2A8F7A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#155E52;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1076" y="356" width="274" height="62" as="geometry" />
        </mxCell>
        <mxCell id="explore_select" value="&lt;b&gt;qKeep=0.80 分位筛选；不足 nMin 则补足&lt;/b&gt;&lt;br&gt;贪心批选：0.75·质量 + 0.25·决策距离 → 4…6 个" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E7F6F2;strokeColor=#2A8F7A;strokeWidth=2.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#155E52;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1076" y="438" width="274" height="62" as="geometry" />
        </mxCell>

        <mxCell id="indicator_coarse" value="&lt;b&gt;关系得分粗筛&lt;/b&gt;&lt;br&gt;前 30%，且至少保留 20 个" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1076" y="572" width="274" height="60" as="geometry" />
        </mxCell>
        <mxCell id="indicator_rerank" value="&lt;b&gt;RBF-SVR 预测 SDE 指标值&lt;/b&gt;&lt;br&gt;仅在粗筛集合内重排序" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1076" y="650" width="274" height="60" as="geometry" />
        </mxCell>
        <mxCell id="indicator_select" value="&lt;b&gt;≥ 70% 分位点&lt;/b&gt;&lt;br&gt;SVR 无效时沿用关系分数&lt;br&gt;输出 nMin…nMax（4…6）个" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF0E3;strokeColor=#E8873A;strokeWidth=2.5;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#7C3D13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1076" y="728" width="274" height="58" as="geometry" />
        </mxCell>

        <mxCell id="mode_merge" value="&lt;b&gt;唯一激活分支&lt;/b&gt;&lt;br&gt;候选合流" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EAFE;strokeColor=#7756C5;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#4C2F91;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1396" y="220" width="146" height="68" as="geometry" />
        </mxCell>
        <mxCell id="fe_clip" value="&lt;b&gt;剩余 FE 裁剪&lt;/b&gt;&lt;br&gt;budget_left" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EAFE;strokeColor=#7756C5;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#4C2F91;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1396" y="362" width="146" height="62" as="geometry" />
        </mxCell>
        <mxCell id="true_eval" value="&lt;b&gt;真实评价&lt;/b&gt;&lt;br&gt;Problem.Evaluation&lt;br&gt;追加 Archive" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EAFE;strokeColor=#7756C5;strokeWidth=2.5;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#4C2F91;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1396" y="492" width="146" height="82" as="geometry" />
        </mxCell>
        <mxCell id="empty_next_fallback" value="&lt;b&gt;Next 为空保护&lt;/b&gt;&lt;br&gt;有预算 → OperatorGA&lt;br&gt;至多取 nMin 个" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F1F3F6;strokeColor=#687387;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#425166;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1394" y="684" width="148" height="82" as="geometry" />
        </mxCell>

        <mxCell id="empty_pairs_safe" value="&lt;b&gt;关系对为空&lt;/b&gt;&lt;br&gt;本代不训练 / 不选择 → 直接 RefSelect" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F1F3F6;strokeColor=#687387;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#425166;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="74" y="828" width="278" height="52" as="geometry" />
        </mxCell>
        <mxCell id="evidence_boundary" value="&lt;b&gt;证据边界&lt;/b&gt;：p_err ≠ 重排质量；score_rel ≠ Pareto 胜率&lt;br&gt;uncertainty / 决策距离是启发式" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F1F3F6;strokeColor=#687387;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#425166;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="374" y="828" width="398" height="52" as="geometry" />
