        <mxCell id="edge_sde_svr" value="Fitness" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E8873A;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#B65C1F;labelBackgroundColor=#FAFBFD;" edge="1" parent="1" source="sde_block" target="svr_model">
