        <mxCell id="edge_relation_input_process" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F6BFF;" edge="1" parent="1" source="relation_inputs" target="relation_process">
