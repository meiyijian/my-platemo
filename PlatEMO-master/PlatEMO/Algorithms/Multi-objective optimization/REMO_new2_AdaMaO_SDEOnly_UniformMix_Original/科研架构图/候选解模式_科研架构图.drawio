        <mxCell id="relation_process" value="&lt;b&gt;GetRelationPairs&lt;/b&gt;&lt;br&gt;DataProcess：按标签分层&lt;br&gt;75% 训练 / 25% 留出" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="226" y="182" width="176" height="90" as="geometry" />
        </mxCell>
        <mxCell id="patternnet" value="&lt;b&gt;普通三分类 patternnet&lt;/b&gt;&lt;br&gt;mapminmax；隐藏层 [⌈3D⌉,2D,D]&lt;br&gt;无样本权重；输出关系得分" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="102" y="306" width="274" height="88" as="geometry" />
