        <mxCell id="edge_indicator_input_sde" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E8873A;" edge="1" parent="1" source="indicator_inputs" target="sde_block">
          <mxGeometry relative="1" as="geometry" />
