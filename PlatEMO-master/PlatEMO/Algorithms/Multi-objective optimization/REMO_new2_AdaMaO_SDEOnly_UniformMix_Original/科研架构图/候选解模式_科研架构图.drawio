        <mxCell id="edge_relation_process_net" value="Train / Test" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2F6BFF;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#2458CE;labelBackgroundColor=#FAFBFD;" edge="1" parent="1" source="relation_process" target="patternnet">
