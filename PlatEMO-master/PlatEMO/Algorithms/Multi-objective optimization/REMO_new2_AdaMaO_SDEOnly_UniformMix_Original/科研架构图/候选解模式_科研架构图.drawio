        <mxCell id="relation_inputs" value="&lt;b&gt;Catalog + decs&lt;/b&gt;&lt;br&gt;硬关系标签 {0,+1,−1}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F2FF;strokeColor=#2F6BFF;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#173B7A;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
